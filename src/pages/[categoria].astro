---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

export async function getStaticPaths() {
  const categorias = {
    laboratorios: 'Laboratorios',
    investigacion: 'Investigación',
    herramientas: 'Herramientas',
    notas: 'Notas técnicas',
  };

  return Object.entries(categorias).map(([slug, titulo]) => ({
    params: { categoria: slug },
    props: { titulo },
  }));
}

const { categoria } = Astro.params;
const { titulo } = Astro.props;

const articulos = (
  await getCollection('articles', ({ data }) => !data.draft && data.category === categoria)
).sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout>
  <main class="terminal">
    <p class="prompt"><span>root@orion</span>:~$ ls ./{categoria}</p>
    <h1>{titulo}</h1>
    <a class="back" href={base}>[ ← VOLVER ]</a>

    <div class="articles">
      {articulos.length === 0 ? (
        <p class="empty">[ INFO ] SIN PUBLICACIONES EN ESTA CATEGORÍA_</p>
      ) : (
        articulos.map((article) => (
          <a class="article" href={`${base}articulos/${article.id}/`}>
            <span class="meta">{article.data.pubDate?.toLocaleDateString('es') ?? ''}</span>
            <h2>{article.data.title}</h2>
            <p>{article.data.description}</p>
          </a>
        ))
      )}
    </div>
  </main>
</Layout>

<style>
  :global(html) {
    background: #080d12;
  }

  :global(body) {
    margin: 0;
    color: #d6e2e8;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    background: radial-gradient(ellipse at 50% 0%, #10252b 0%, transparent 55%), #080d12;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .terminal {
    width: min(1100px, 100%);
    margin: 48px auto;
    padding: 0 28px;
  }

  .prompt {
    color: #91a8b2;
    font-size: 12px;
  }

  .prompt span,
  .meta {
    color: #5eead4;
  }

  h1 {
    margin: 20px 0 16px;
    color: #f0fdfa;
    font-size: clamp(36px, 7vw, 60px);
    letter-spacing: -2px;
  }

  .back {
    display: inline-block;
    margin-bottom: 36px;
    color: #b8cbd2;
    font-size: 11px;
  }

  .back:hover {
    color: #5eead4;
  }

  .articles {
    display: grid;
    gap: 14px;
  }

  .article,
  .empty {
    display: block;
    padding: 22px 24px;
    border: 1px solid #263b43;
    background: rgb(12 20 26 / 70%);
  }

  .article:hover {
    border-color: #5eead4;
  }

  .meta {
    font-size: 10px;
    text-transform: uppercase;
  }

  h2 {
    margin: 12px 0 10px;
    color: #e2f0f2;
    font-size: 18px;
  }

  .article p {
    margin: 0;
    color: #91a8b2;
    font-size: 13px;
    line-height: 1.7;
  }

  .empty {
    margin: 0;
    color: #65818c;
    font-size: 11px;
  }
</style>
