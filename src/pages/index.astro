---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => {
  const fechaA = a.data.pubDate?.valueOf() ?? 0;
  const fechaB = b.data.pubDate?.valueOf() ?? 0;
  return fechaB - fechaA || a.data.title.localeCompare(b.data.title);
});
---

<Layout>
  <main class="terminal">
    <header class="topbar">
      <div class="window-controls" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <span class="window-title">orion.lab — personal cybersec environment</span>
      <span class="status"><span class="status-dot"></span> ONLINE</span>
    </header>

    <nav class="navigation" aria-label="Navegación principal">
      <a class="brand" href="#home">ORION<span>.LAB</span></a>
      <div class="nav-links">
        <a href="#about">[ ACERCA DE ]</a>
        <a href="#topics">[ ÁREAS ]</a>
        <a href="#contact">[ CONTACTO ]</a>
      </div>
    </nav>

    <section class="hero" id="home">
      <p class="prompt"><span>root@orion</span>:~$ whoami</p>

      <p class="eyebrow">INDEPENDENT CYBERSECURITY PROJECT</p>
      <h1>ORION<span>.LAB</span></h1>

      <p class="subtitle">
        Explorar. <span>Comprender.</span> Proteger.
      </p>

      <p class="description">
        Un espacio personal para documentar laboratorios, investigar
        tecnologías y compartir conocimiento sobre ciberseguridad.
      </p>

      <div class="hero-actions">
        <a class="button primary" href="#topics">[ EXPLORAR ARCHIVOS ]</a>
        <a class="button secondary" href="#about">[ SOBRE EL PROYECTO ]</a>
      </div>

      <div class="system-info">
        <span>SYS.STATUS: OPERATIONAL</span>
        <span>MODE: RESEARCH</span>
        <span>ACCESS: PUBLIC</span>
      </div>
    </section>

    <section class="section" id="about">
      <p class="prompt"><span>root@orion</span>:~$ cat about.txt</p>
      <h2>Un laboratorio de <span>conocimiento.</span></h2>
      <p class="section-copy">
        Este proyecto es un espacio para aprender, experimentar y
        registrar conocimientos técnicos. Cada publicación busca explicar
        no solo qué hacer, sino también cómo funciona y por qué importa.
      </p>
    </section>

<section class="section" id="topics">
      <p class="prompt"><span>root@orion</span>:~$ ls ./directories</p>
      <h2>Explorar <span>directorios</span></h2>

      <div class="directory-grid">
        <a class="directory-card" href={${import.meta.env.BASE_URL}laboratorios/}>
          <span class="file-icon">[01]</span>
          <h3>Laboratorios</h3>
          <p>Prácticas, desafíos y notas técnicas.</p>
          <span class="card-footer">DIRECTORY /labs</span>
        </a>

        <a class="directory-card" href={${import.meta.env.BASE_URL}investigacion/}>
          <span class="file-icon">[02]</span>
          <h3>Investigación</h3>
          <p>Análisis, observaciones y aprendizaje.</p>
          <span class="card-footer">DIRECTORY /research</span>
        </a>

        <a class="directory-card" href={${import.meta.env.BASE_URL}herramientas/}>
          <span class="file-icon">[03]</span>
          <h3>Herramientas</h3>
          <p>Utilidades, comandos y scripts propios.</p>
          <span class="card-footer">DIRECTORY /tools</span>
        </a>

        <a class="directory-card" href={${import.meta.env.BASE_URL}notas/}>
          <span class="file-icon">[04]</span>
          <h3>Notas técnicas</h3>
          <p>Redes, Linux, protocolos y seguridad.</p>
          <span class="card-footer">DIRECTORY /notes</span>
        </a>
      </div>
      <div class="articles" id="publicaciones">
        {
          articles.length === 0 ? (
            <p class="coming-soon">[ INFO ] PUBLICACIONES: EN CONSTRUCCIÓN_</p>
          ) : (
            articles.map((article) => (
              <a class="article-link" href={`${import.meta.env.BASE_URL}/articulos/${article.id}`}>
                <span class="article-meta">
                  {article.data.category}{article.data.pubDate ? ` · ${article.data.pubDate.toLocaleDateString('es')}` : ''}
                </span>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </a>
            ))
          )
        }
      </div>
    </section>

    <section class="section about-panel" id="contact">
      <p class="prompt"><span>root@orion</span>:~$ echo $CONTACT</p>
      <h2>Conocimiento abierto. <span>Aprendizaje continuo.</span></h2>
      <p class="section-copy">
        ORION.LAB es un proyecto personal en desarrollo.
        Próximamente, nuevos artículos y recursos técnicos.
      </p>
      <div class="contact-links">
        <a href="mailto:damianramirez749@gmail.com"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>[ EMAIL ] damianramirez749@gmail.com</a>
        <a href="https://www.linkedin.com/in/drazcaballero/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>[ LINKEDIN ] in/drazcaballero</a>
        <a href="https://www.youtube.com/@draz1006" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 9l5 3-5 3z" fill="currentColor"/></svg>[ YOUTUBE ] @draz1006</a>
        <a href="https://www.instagram.com/drazcaballero/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>[ INSTAGRAM ] drazcaballero</a>
      </div>
    </section>

    <footer>
      <span>ORION.LAB © 2026</span>
      <span>BUILT FOR LEARNING <span class="cursor">_</span></span>
    </footer>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    background: #080d12;
  }

  :global(body) {
    margin: 0;
    color: #d6e2e8;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    background:
      radial-gradient(ellipse at 50% 0%, #10252b 0%, transparent 55%),
      #080d12;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .terminal {
    width: min(1100px, 100%);
    margin: 32px auto;
    padding: 0 28px;
  }

  .topbar {
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 16px;
    border: 1px solid #263b43;
    background: #0c141a;
    font-size: 11px;
    color: #8ca2ad;
  }

  .window-controls {
    display: flex;
    gap: 6px;
  }

  .window-controls span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #36515b;
  }

  .window-controls span:first-child {
    background: #5eead4;
  }

  .window-title {
    flex: 1;
  }

  .status {
    color: #5eead4;
  }

  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 50%;
    background: #5eead4;
  }

  .navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 28px 0;
    border-bottom: 1px solid #20323a;
  }

  .brand {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -1px;
    color: #f0fdfa;
  }

  .brand span,
  h1 span,
  h2 span {
    color: #5eead4;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 11px;
    color: #9aafb9;
  }

  .nav-links a:hover,
  .directory-card:hover {
    color: #5eead4;
  }

  .hero {
    padding: 100px 0 72px;
    border-bottom: 1px solid #20323a;
  }

  .prompt {
    color: #91a8b2;
    font-size: 12px;
    margin: 0 0 34px;
  }

  .prompt span {
    color: #5eead4;
  }

  .eyebrow {
    color: #5eead4;
    font-size: 11px;
    letter-spacing: 3px;
  }

  h1 {
    margin: 16px 0;
    color: #f0fdfa;
    font-size: clamp(52px, 10vw, 100px);
    letter-spacing: -5px;
    line-height: 1;
  }

  .subtitle {
    font-size: clamp(19px, 3vw, 28px);
    color: #d6e2e8;
  }

  .subtitle span {
    color: #5eead4;
  }

  .description,
  .section-copy {
    max-width: 660px;
    color: #91a8b2;
    font-size: 14px;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button {
    padding: 13px 16px;
    font-size: 11px;
    border: 1px solid #2b5556;
  }

  .primary {
    color: #071310;
    background: #5eead4;
    font-weight: bold;
  }

  .primary:hover {
    background: #a7f3e8;
  }

  .secondary {
    color: #b8cbd2;
  }

  .secondary:hover {
    border-color: #5eead4;
    color: #5eead4;
  }

  .system-info {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 54px;
    color: #65818c;
    font-size: 10px;
  }

  .section {
    padding: 68px 0;
    border-bottom: 1px solid #20323a;
  }

  h2 {
    margin: 0 0 20px;
    color: #f0fdfa;
    font-size: clamp(23px, 4vw, 34px);
    letter-spacing: -1px;
  }

  .section .prompt {
    margin-bottom: 24px;
  }

  .directory-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 30px;
  }

  .directory-card {
    display: block;
    padding: 24px;
    border: 1px solid #263b43;
    background: rgb(12 20 26 / 70%);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .directory-card:hover {
    border-color: #5eead4;
    transform: translateY(-2px);
  }

  .file-icon {
    color: #5eead4;
    font-size: 12px;
  }

  h3 {
    margin: 22px 0 10px;
    color: #e2f0f2;
    font-size: 17px;
  }

  .directory-card p {
    min-height: 42px;
    color: #91a8b2;
    font-size: 12px;
    line-height: 1.7;
  }

  .card-footer {
    display: block;
    margin-top: 22px;
    color: #5eead4;
    font-size: 10px;
  }

  .coming-soon {
    margin-top: 24px;
    color: #65818c;
    font-size: 10px;
  }

  .articles {
    display: grid;
    gap: 14px;
    margin-top: 30px;
  }

  .article-link {
    display: block;
    padding: 22px 24px;
    border: 1px solid #263b43;
    background: rgb(12 20 26 / 70%);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .article-link:hover {
    border-color: #5eead4;
    transform: translateY(-2px);
  }

  .article-meta {
    color: #5eead4;
    font-size: 10px;
    text-transform: uppercase;
  }

  .article-link p {
    color: #91a8b2;
    font-size: 12px;
    line-height: 1.7;
  }

  .about-panel {
    margin-bottom: 12px;
  }

  .contact-links {
    display: grid;
    gap: 10px;
    margin-top: 24px;
    font-size: 12px;
  }

  .contact-links a {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #5eead4;
  }

  .contact-links svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .contact-links a:hover {
    text-decoration: underline;
  }

  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 25px 0;
    color: #65818c;
    font-size: 10px;
  }

  .cursor {
    color: #5eead4;
    animation: blink 1s steps(2, start) infinite;
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  @media (max-width: 600px) {
    .terminal {
      margin: 12px auto;
      padding: 0 16px;
    }

    .topbar {
      gap: 10px;
      padding: 0 10px;
      font-size: 9px;
    }

    .navigation {
      align-items: flex-start;
      flex-direction: column;
    }

    .nav-links {
      gap: 12px;
      font-size: 10px;
    }

    .hero {
      padding-top: 66px;
    }

    h1 {
      letter-spacing: -3px;
    }

    .directory-grid {
      grid-template-columns: 1fr;
    }

    .directory-card {
      padding: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .cursor {
      animation: none;
    }

    .directory-card {
      transition: none;
    }
  }
</style>
